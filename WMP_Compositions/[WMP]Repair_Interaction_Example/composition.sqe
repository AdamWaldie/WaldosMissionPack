version=54;
center[]={0,0,0};
class items
{
	items=3;
	class Item0
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={0,0,0};};
		class Attributes
		{
			name="WMP_Interaction_Repair_Console";
			init="[this, ""repair"", createHashMapFromArray [[""difficulty"", ""standard""], [""actionTitle"", ""Open Maintenance Hatch""], [""title"", ""MAINTENANCE HATCH""], [""onSuccess"", {params ['_obj']; private _mrap = nearestObject [_obj, 'B_MRAP_01_F']; if (!isNull _mrap) then {_mrap setDamage 0; _mrap engineOn true;}; ['Repairs complete. Vehicle operational.'] remoteExec ['systemChat', 0];}], [""onFailure"", {['Repair attempt failed. The vehicle remains disabled.'] remoteExec ['systemChat', 0];}]]] call Waldo_fnc_MiniGameInteractionSetup;";
		};
		id=1;
		type="Land_AirConditioner_03_F";
	};
	class Item1
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={4,2,0};};
		class Attributes
		{
			name="WMP_Interaction_Repair_MRAP";
			init="this setDamage 0.9;";
		};
		id=2;
		type="B_MRAP_01_F";
	};
	class Item2
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-4,0};};
		title="Repair Interaction Example: a real gameplay outcome, not just the procedure by itself. The nearby MRAP starts heavily damaged (0.9) with its engine off; passing the repair procedure sets its damage to 0 and starts the engine, failing leaves it disabled. Copy the onSuccess pattern in the console's init field onto your own object to repair anything else. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Waldos-Mini-Games";
		id=3;
	};
};
