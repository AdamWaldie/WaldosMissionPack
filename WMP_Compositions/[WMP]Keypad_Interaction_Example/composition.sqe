version=54;
center[]={0,0,0};
class items
{
	items=3;
	class Item0
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={0,0,0};};
		class Attributes
		{
			name="WMP_Interaction_Keypad_Console";
			init="[this, ""keypad"", createHashMapFromArray [[""difficulty"", ""hard""], [""actionTitle"", ""Access Security Terminal""], [""title"", ""SECURITY TERMINAL""], [""onSuccess"", {params ['_obj']; private _van = nearestObject [_obj, 'C_Van_01_transport_F']; if (!isNull _van) then {_van lock false;}; ['Access granted. Supply van unlocked.'] remoteExec ['systemChat', 0];}], [""onFailure"", {['Access denied.'] remoteExec ['systemChat', 0];}]]] call Waldo_fnc_MiniGameInteractionSetup;";
		};
		id=1;
		type="Land_Router_01_sand_F";
	};
	class Item1
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={4,2,0};};
		class Attributes
		{
			name="WMP_Interaction_Keypad_Van";
			init="this lock true;";
		};
		id=2;
		type="C_Van_01_transport_F";
	};
	class Item2
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-4,0};};
		title="Keypad Interaction Example: a real gameplay outcome, not just the procedure by itself. The van starts locked; passing the keypad procedure unlocks it, failing leaves it locked. Copy the onSuccess/onFailure pattern in the console's init field onto your own object, and swap the nearestObject classname for whatever you want to unlock. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Waldos-Mini-Games";
		id=3;
	};
};
