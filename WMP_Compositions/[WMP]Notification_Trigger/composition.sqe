version=54;
center[]={0,0,0};
class items
{
	items=2;
	class Item0
	{
		dataType="Object";
		class PositionInfo {position[]={0,0,0};};
		side="Empty";
		flags=4;
		class Attributes
		{
			name="WMP_NotificationTriggerAnchor";
			init="[this, 25, ""MESSAGE FROM COMMAND"", ""Edit this message in the anchor object's Init field."", ""INFO""] call Waldo_fnc_NotificationTrigger;";
		};
		id=1;
		type="Land_HelipadEmpty_F";
	};
	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,0,-32};};
		title="Notification area: this empty-helipad anchor creates a safe 25 m server-owned trigger and sends one INFO card to all players who enter. Move the anchor to move the area. Edit the radius, title, message and type in the anchor object's Init field; add recipients, duration or repeatability only when needed. The trigger itself is created at runtime because hand-authored Trigger entities can crash Eden during composition placement. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Custom-UI-Notifications";
		id=2;
	};
};
