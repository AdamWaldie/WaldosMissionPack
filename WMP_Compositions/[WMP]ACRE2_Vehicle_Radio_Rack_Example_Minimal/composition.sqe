    class Item1
    {
        dataType="Comment";
		class PositionInfo {position[]={0,0,-8};};
        title="ACRE2 Vehicle Radio Rack (Minimal): the smallest working call. This Hunter already has ACRE racks. EXISTING_RACKS_COY tunes every compatible radio already mounted in them to the WEST COY net; empty racks stay empty. ALL is deliberately tune-only here. On dedicated servers WMP waits automatically for an ACRE-ready player. See the Full composition for mounting a radio into a selected rack. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/ACRE2-Vehicle-Radio-Rack-Setup";
        id=2;
    };
