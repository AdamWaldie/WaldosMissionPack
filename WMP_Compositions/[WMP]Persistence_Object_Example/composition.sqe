	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-4,0};};
		title="Persistence Object Example: registers this crate's cargo, damage and position with Waldo_fnc_PersistenceRegisterObject - no isServer wrapper needed, the same public call is safe to leave directly in an object's init field on every machine. Does nothing until Waldo_Persistence_Enable is set true in MissionConfig\persistenceConfig.sqf (or via the Zeus ""Persistence - Control"" module) and a working server INIDBI2 extension is detected; use ""Persistence - Register Object"" in Zeus to do the same during play instead. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Optional-Feature-Systems#persistence";
		id=2;
	};
};
