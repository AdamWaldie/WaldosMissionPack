		class Attributes
		{
			name="WMP_PersistentSupplyCrate";
			init="[this, ""composition_persistence_crate"", [true, true, false, false, true]] call Waldo_fnc_PersistenceRegisterObject;";
		};
		id=1;
		type="Box_NATO_Equip_F";
