            name="wmp_supply_buggy";
            init="if (isServer) then {this setVariable [""Waldo_PhysicalCargo_SeatPoints"", [[""TURRET"", [0], [-0.57409, -0.76453, -1.10891]], [""TURRET"", [1], [0.64737, -0.75992, -1.10891]], [""TURRET"", [2], [0.64737, 0.21741, -1.10891]], [""TURRET"", [3], [0.63091, -1.59534, -0.89094]], [""TURRET"", [4], [-0.71477, -1.63306, -0.89094]], [""TURRET"", [5], [0.03284, -0.09595, -1.14049]]], true];}; [this] call Waldo_fnc_SupplyTransfersRegister;";
