		class Attributes
		{
			name="WMP_PersistentSupplyCrate";
			init="[this, ""composition_persistence_crate_minimal""] call Waldo_fnc_PersistenceRegisterObject;";
		};
		id=1;
		type="Box_NATO_Equip_F";
	};
	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-4,0};};
		title="Persistence Object Example (Minimal): the smallest working call - a stable key and the object are all that's required. Omitting the options array saves everything by default (cargo, damage, fuel, ammo/pylons and position). No isServer wrapper needed - safe to leave directly in an object's init field on every machine. Does nothing until Waldo_Persistence_Enable is set true (see the Full composition's comment). See the Persistence Object Example (Full) composition to see and edit which fields are saved. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Optional-Feature-Systems#persistence";
		id=2;
	};
};
