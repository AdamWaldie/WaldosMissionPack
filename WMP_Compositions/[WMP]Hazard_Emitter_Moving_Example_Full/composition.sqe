	class Item0
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={0,0,0};};
		class Attributes
		{
			name="WMP_HazardEmitterVehicle";
			init="[""composition_radiation_emitter_mobile"", this, 20, createHashMapFromArray [[""type"", ""RADIATION""], [""label"", ""Contaminated Transport""], [""rate"", 1], [""decay"", 0.15], [""damageThresholds"", [[15, 0.02], [35, 0.06]]], [""protectInVehicles"", true], [""vehicleFactor"", 0.1], [""markerEnabled"", false], [""audioEnabled"", true], [""geigerLowSounds"", [""Waldo_Hazard_GeigerLow1"", ""Waldo_Hazard_GeigerLow2"", ""Waldo_Hazard_GeigerLow3"", ""Waldo_Hazard_GeigerLow4""]], [""geigerHighSounds"", [""Waldo_Hazard_Geiger1"", ""Waldo_Hazard_Geiger2"", ""Waldo_Hazard_Geiger3"", ""Waldo_Hazard_Geiger4""]], [""geigerHighIntensity"", 0.5], [""geigerMinimumInterval"", 0.5], [""geigerMaximumInterval"", 2.5]]] call Waldo_fnc_HazardRegisterEmitter;";
		};
		id=1;
		type="C_Van_01_transport_F";
	};
	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-5,0};};
		title="Hazard Emitter (Moving) (Full parameter reference): a 20 m contamination field that follows this vehicle wherever it is driven, instead of a fixed-area zone - the moving counterpart to the Radiation Hazard Example composition. Uses Waldo_fnc_HazardRegisterEmitter directly with a hand-authored profile (no preset key), every option shown explicitly; drag this same call onto any other object to make it the hazard's source. markerEnabled (shown here as false, matching its off-by-default API) can be set to true to tie a broadcast world marker to this vehicle so every player can see where the danger is, not just whoever is currently exposed. The event handler that unregisters the zone (and any marker) if this vehicle is destroyed/deleted is installed automatically regardless. See the Hazard Emitter Moving Example (Minimal) composition for the smallest working call. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Optional-Feature-Systems#hazardous-environments";
		id=2;
	};
};
