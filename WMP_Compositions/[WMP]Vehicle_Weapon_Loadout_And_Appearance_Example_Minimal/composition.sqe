	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,0,-8};};
		title="Vehicle Weapon Loadout And Appearance (Minimal): the smallest working call for each feature, no classname ever needed. Waldo_fnc_VehicleWeaponLoadoutApply clears this armed Hunter's real turret[0] - CLEAR never needs a weapon or magazine classname. Waldo_fnc_VehicleAppearanceApply then paints texture slot 0 solid pink using the built-in procedural syntax, no texture asset required either. Use the Full example for Copy-based loadout transfer between two vehicles. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Vehicle-Weapon-Loadout";
		id=2;
	};
};
