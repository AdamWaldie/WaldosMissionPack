			name="WMP_VehWpnMinimal";
			init="[this, [[""TURRET"", [0], -1, ""CLEAR"", """", """", 0]]] call Waldo_fnc_VehicleWeaponLoadoutApply; [this, [[""TEXTURE"", 0, ""SET"", [1,0,1,1]]]] call Waldo_fnc_VehicleAppearanceApply;";
