		fillName="Border";
		alpha=1;
		a=1;
		b=1;
		angle=0;
		id=111;
	};
	class Item3
	{
		dataType="Comment";
		class PositionInfo {position[]={0,0,-6};};
		title="Airborne gunship guided example. The VTOL already has its complete four-person BLUFOR editor crew: pilot, copilot and both weapon operators. Its init registers that existing aircraft as SPECTRE and never creates crew. Move the Gunship Orbit marker to set the patrol centre; registration removes that placeholder and replaces it with SPECTRE's live orbit marker. The separately grouped BLUFOR gunshipController receives control at mission start. Keep aircraft/crew simulation enabled and edit named settings in the aircraft init. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Airborne-Gunship-Support";
		id=112;
	};
};
