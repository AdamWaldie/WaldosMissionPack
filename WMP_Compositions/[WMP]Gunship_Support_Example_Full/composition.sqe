version=54;
center[]={0,0,0};
class items
{
	items=5;
	class Item0
	{
		dataType="Group";
		side="West";
		class Entities
		{
			items=2;
			class Item0
			{
				dataType="Object";
				class PositionInfo {position[]={0,0,0};};
				side="West";
				flags=6;
				class Attributes {name="gunshipPilotAnchor";};
				id=101;
				type="B_Pilot_F";
			};
			class Item1
			{
				dataType="Object";
				class PositionInfo {position[]={0,6,0};};
				side="West";
				class Attributes {};
				id=102;
				type="B_Pilot_F";
				atlOffset=6;
			};
		};
		class Attributes {speedMode="LIMITED";};
		class CrewLinks
		{
			class LinkIDProvider {nextID=2;};
			class Links
			{
				items=2;
				class Item0
				{
					linkID=0;
					item0=101;
					item1=110;
					class CustomData {role=1;};
				};
				class Item1
				{
					linkID=1;
					item0=102;
					item1=110;
					class CustomData {role=2; turretPath[]={0};};
				};
			};
		};
		id=100;
		atlOffset=700;
	};
	class Item4
	{
		dataType="Object";
		class PositionInfo {position[]={4,0,4};};
		side="West";
		flags=6;
		class Attributes
		{
			init="if (isServer) then {[this] spawn {params [""_unit""]; waitUntil {sleep 0.1; ""EXAMPLE_GUNSHIP"" in keys (missionNamespace getVariable [""Waldo_Gunship_Registry"", createHashMap])}; [""EXAMPLE_GUNSHIP"", ""ASSIGN"", [_unit], objNull] call Waldo_fnc_GunshipServerHandle;};};";
			name="gunshipController";
			description="Gunship Controller (FAC/JTAC) - already assigned to SPECTRE on mission start; see this unit's init field.";
		};
		id=113;
		type="B_Soldier_TL_F";
	};
	class Item1
	{
		dataType="Object";
		class PositionInfo {position[]={0,0,0};};
		side="West";
		flags=2;
		class Attributes
		{
			init="[createHashMapFromArray [[""id"", ""EXAMPLE_GUNSHIP""], [""aircraft"", this], [""callsign"", ""SPECTRE""], [""side"", west], [""home"", getPosATL this], [""orbit"", getMarkerPos ""gunshipOrbit""], [""radius"", 1500], [""altitude"", 700]]] call Waldo_fnc_GunshipRegister;";
			name="gunshipAircraft";
			reportOwnPosition=1;
		};
		id=110;
		type="B_T_VTOL_01_armed_F";
		atlOffset=700;
	};
	class Item2
	{
		dataType="Marker";
		position[]={300,0,300};
		name="gunshipOrbit";
		text="Gunship Orbit";
		type="mil_end";
		colorName="ColorBlue";
		fillName="Border";
		a=1;
		b=1;
		angle=0;
		id=111;
	};
	class Item3
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-6,0};};
		title="Airborne Gunship Support (Full parameter reference): this crewed VTOL is registered with Waldo_fnc_GunshipRegister on mission start with callsign/side/home/orbit/radius/altitude all shown explicitly - it flies to and orbits the ""Gunship Orbit"" marker (drag it to reposition), automatically returns to service at low fuel/damage/ammo per the configured envelope, then resumes its orbit. The nearby ""gunshipController"" unit (a rifleman - stand-in for a real FAC/JTAC role) is automatically assigned as SPECTRE's controller on mission start via its own init field, a server-only Waldo_fnc_GunshipServerHandle ""ASSIGN"" call that waits for registration to finish first - copy that one-line pattern onto any unit to make it the standing controller without touching Zeus. Without an assignment like this, any player on a friendly side can still see status, but weapon control, orbit retasking and service recall stay locked - a curator can always reassign later with ""Gunship: Assign Controller"" (or the init call above can add [""controller"", someUnit] / [""controllerUID"", ""...""] directly). Give a curator the ""Airborne Gunship Support"" ZEN menu for live control (request service, retask, change orbit) instead of duplicating this composition. See the Gunship Support Example (Minimal) composition for the smallest working call. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Airborne-Gunship-Support";
		id=112;
	};
};
