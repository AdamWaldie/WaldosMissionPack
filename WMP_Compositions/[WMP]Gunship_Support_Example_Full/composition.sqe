		class PositionInfo {position[]={0,0,0};};
		side="West";
		flags=2;
		class Attributes
		{
			init="[createHashMapFromArray [[""id"", ""EXAMPLE_GUNSHIP""], [""aircraft"", this], [""callsign"", ""SPECTRE""], [""side"", west], [""home"", getPosATL this], [""orbit"", ""gunshipOrbit""], [""radius"", 1500], [""altitude"", 700]]] call Waldo_fnc_GunshipRegister;";
			name="gunshipAircraft";
			reportOwnPosition=1;
