version=54;
center[]={0,0,0};
class items
{
	items=5;
	class Item0
	{
		dataType="Group";
		side="West";
		class Entities
		{
			items=2;
			class Item0
			{
				dataType="Object";
				class PositionInfo {position[]={0,0,0};};
				side="West";
				flags=6;
				class Attributes {name="gunshipPilotAnchor";};
				id=101;
				type="B_Pilot_F";
			};
			class Item1
			{
				dataType="Object";
				class PositionInfo {position[]={0,6,0};};
				side="West";
				class Attributes {};
				id=102;
				type="B_Pilot_F";
				atlOffset=6;
			};
		};
		class Attributes {speedMode="LIMITED";};
		class CrewLinks
		{
			class LinkIDProvider {nextID=2;};
			class Links
			{
				items=2;
				class Item0
				{
					linkID=0;
					item0=101;
					item1=110;
					class CustomData {role=1;};
				};
				class Item1
				{
					linkID=1;
					item0=102;
					item1=110;
					class CustomData {role=2; turretPath[]={0};};
				};
			};
		};
		id=100;
		atlOffset=700;
	};
	class Item4
	{
		dataType="Object";
		class PositionInfo {position[]={4,0,4};};
		side="West";
		flags=6;
		class Attributes
		{
			init="[this, ""EXAMPLE_GUNSHIP""] call Waldo_fnc_GunshipAssignControllerOnStart;";
			name="gunshipController";
			description="Gunship Controller (FAC/JTAC) - already assigned to SPECTRE on mission start; see this unit's init field.";
		};
		id=113;
		type="B_Soldier_TL_F";
	};
	class Item1
	{
		dataType="Object";
		class PositionInfo {position[]={0,0,0};};
		side="West";
		flags=2;
		class Attributes
		{
			init="[createHashMapFromArray [[""id"", ""EXAMPLE_GUNSHIP""], [""aircraft"", this], [""callsign"", ""SPECTRE""], [""side"", west], [""home"", getPosATL this], [""orbit"", getMarkerPos ""gunshipOrbit""], [""radius"", 1500], [""altitude"", 700]]] call Waldo_fnc_GunshipRegister;";
			name="gunshipAircraft";
			reportOwnPosition=1;
		};
		id=110;
		type="B_T_VTOL_01_armed_F";
		atlOffset=700;
	};
	class Item2
	{
		dataType="Marker";
		position[]={300,0,300};
		name="gunshipOrbit";
		text="Gunship Orbit";
		type="mil_end";
		colorName="ColorBlue";
		fillName="Border";
		alpha=1;
		a=1;
		b=1;
		angle=0;
		id=111;
	};
	class Item3
	{
		dataType="Comment";
		class PositionInfo {position[]={0,0,-6};};
		title="Airborne gunship guided example. The VTOL already has correctly sided pilot and turret crew; its init registers that existing aircraft as SPECTRE and does not create crew. Move the Gunship Orbit marker to set the patrol centre. The nearby gunshipController unit receives control at mission start. Keep aircraft/crew simulation enabled and edit named settings in the aircraft init. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Airborne-Gunship-Support";
		id=112;
	};
};
