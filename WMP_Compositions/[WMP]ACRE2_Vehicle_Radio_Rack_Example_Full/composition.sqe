    {
        dataType="Comment";
		class PositionInfo {position[]={0,0,-8};};
        title="ACRE2 Vehicle Radio Rack (guided example): COMMAND_VEHICLE selects the AN/VRC-110 by class and occurrence 1, mounts its compatible PRC-152 when needed, and tunes it to WEST AIR-GND. The existing fixed PRC-117F is not replaced. Only removable racks accept a radio classname or REMOVE_RACK. WMP waits for an ACRE-ready player on dedicated servers. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/ACRE2-Vehicle-Radio-Rack-Setup";
        id=2;
    };
