		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={0,0,0};};
		class Attributes
		{
			name="WMP_Interaction_Circuit_Console";
			init="[this, ""circuit"", createHashMapFromArray [[""difficulty"", ""standard""], [""actionTitle"", ""Reroute Breaker Cabinet""], [""title"", ""BREAKER CABINET""], [""onSuccess"", {['Power rerouted safely.'] remoteExec ['systemChat', 0];}], [""onFailure"", {params ['_obj']; [getPosATL _obj, 20, 15] call Waldo_fnc_EMP; ['Power surge! Nearby electronics are fried.'] remoteExec ['systemChat', 0];}]]] call Waldo_fnc_MiniGameInteractionSetup;";
		};
		id=1;
		type="Land_PortableServer_01_sand_F";
	};
	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,0,-4};};
		title="Circuit Interaction Example: a real gameplay outcome, not just the procedure by itself. Failing the breaker cabinet fires a genuine Waldo_fnc_EMP burst (20 m, 15 s) centred on the cabinet - nearby NVGs and vehicle engines go down for the duration. Passing is safe. Copy the onFailure pattern in the console's init field onto your own object to attach any real consequence to failure. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Waldos-Mini-Games";
		id=2;
	};
