version=54;
center[]={0,0,0};
class items
{
    items=3;
    class Item0
    {
        dataType="Object";
        side="Empty";
        class PositionInfo {position[]={-5,0,0};};
        class Attributes
        {
            name="wmp_base_hq";
            init="[this, ""MainBase"", ""Headquarters"", [""SAVE"", ""HEAL"", ""SPECTATE"", ""TELEPORT""]] call Waldo_fnc_BaseServicesRegisterNode;";
        };
        id=1;
        type="Land_InfoStand_V2_F";
    };
    class Item1
    {
        dataType="Object";
        side="Empty";
        class PositionInfo {position[]={5,0,0};};
        class Attributes
        {
            name="wmp_base_fob";
            init="[this, ""MainBase"", ""Forward Base"", [""SAVE"", ""HEAL"", ""SPECTATE"", ""TELEPORT""]] call Waldo_fnc_BaseServicesRegisterNode;";
        };
        id=2;
        type="Land_InfoStand_V2_F";
    };
    class Item2
    {
        dataType="Comment";
        class PositionInfo {position[]={0,0,-4};};
        title="Enable Waldo_BaseServices_Enable in MissionConfig/missionSystemsConfig.sqf. Each stand has its own Init call. MainBase links them for travel; the label is the destination name. SAVE, HEAL, SPECTATE and TELEPORT are the actions on that stand. Remove an action from one stand without changing the other. Keep TELEPORT on both for two-way travel. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Base-Services";
        id=3;
    };
};
