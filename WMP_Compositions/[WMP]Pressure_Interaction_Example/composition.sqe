version=54;
center[]={0,0,0};
class items
{
	items=2;
	class Item0
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={0,0,0};};
		class Attributes
		{
			name="WMP_Interaction_Pressure_Console";
			init="[this, ""pressure"", createHashMapFromArray [[""difficulty"", ""expert""], [""actionTitle"", ""Vent Hydraulic Manifold""], [""title"", ""HYDRAULIC MANIFOLD""], [""onSuccess"", {['Pressure vented safely.'] remoteExec ['systemChat', 0];}], [""onFailure"", {params ['_obj', '_actor']; _actor setDamage ((damage _actor) + 0.15); ['Scalded by escaping steam!'] remoteExec ['systemChat', 0];}]]] call Waldo_fnc_MiniGameInteractionSetup;";
		};
		id=1;
		type="Land_PortableCabinet_01_7drawers_sand_F";
	};
	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-4,0};};
		title="Pressure Interaction Example: a real gameplay outcome, not just the procedure by itself. Failing the manifold procedure applies real damage (+0.15) directly to the acting player - a genuine consequence, not just a message. Passing vents safely. Copy the onFailure pattern in the console's init field onto your own object for any other real penalty. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Waldos-Mini-Games";
		id=2;
	};
};
