	class Item2
	{
		dataType="Comment";
		class PositionInfo {position[]={4,0,-8};};
		title="Vehicle Weapon Loadout And Appearance example: the armed Hunter (HMG) donates its real turret loadout to the unarmed Hunter beside it via Waldo_fnc_VehicleWeaponLoadoutCopy - no weapon or magazine classname is ever typed, since Copy reads the donor turret state live at mission start. The receiving Hunter is also painted solid pink via Waldo_fnc_VehicleAppearanceApply, using the built-in procedural texture syntax that needs no texture asset. Zeus offers the same workflow at runtime. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Vehicle-Weapon-Loadout";
		id=3;
	};
};
