version=54;
center[]={0,0,0};
class items
{
	items=3;
	class Item0
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={0,0,0};};
		class Attributes
		{
			name="WMP_Interaction_RadioTune_Console";
			init="[this, ""radiotune"", createHashMapFromArray [[""difficulty"", ""hard""], [""actionTitle"", ""Tune Field Antenna""], [""title"", ""FIELD ANTENNA""], [""onSuccess"", {params ['_obj']; private _jammer = nearestObject [_obj, 'Land_TTowerSmall_1_F']; if (!isNull _jammer) then {[_jammer, false] call Waldo_fnc_JammerToggle;}; ['Signal locked. The enemy jammer is suppressed.'] remoteExec ['systemChat', 0];}], [""onFailure"", {['Signal lost. Jamming continues.'] remoteExec ['systemChat', 0];}]]] call Waldo_fnc_MiniGameInteractionSetup;";
		};
		id=1;
		type="SatelliteAntenna_01_Sand_F";
	};
	class Item1
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={4,2,0};};
		class Attributes
		{
			name="WMP_Interaction_RadioTune_Jammer";
			init="[this] call Waldo_fnc_Jammer;";
		};
		id=2;
		type="Land_TTowerSmall_1_F";
	};
	class Item2
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-4,0};};
		title="RadioTune Interaction Example: a real gameplay outcome, not just the procedure by itself. The nearby tower is a live 300 m radio jammer (Waldo_fnc_Jammer); passing the antenna tuning procedure calls Waldo_fnc_JammerToggle to switch it off, failing leaves it jamming. Copy the onSuccess pattern in the console's init field onto your own object to counter any jammer. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Waldos-Mini-Games";
		id=3;
	};
};
