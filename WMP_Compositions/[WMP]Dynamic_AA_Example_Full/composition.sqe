version=54;
center[]={0,0,0};
class items
{
	items=2;
	class Item0
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={0,0,0};};
		class Attributes
		{
			name="WMP_DynamicAA_Anchor";
			init="[createHashMapFromArray [[""id"", ""composition_aa""], [""displayName"", ""Training Air Defence""], [""centre"", getPosATL this], [""side"", west], [""radius"", 2000], [""engagementRadius"", 1500], [""minimumAltitude"", 100], [""maximumAltitude"", 1500], [""radarCount"", 1], [""staticCount"", 1], [""mobileCount"", 1], [""fighterCount"", 0], [""createMarkers"", true], [""showMarkerDetails"", true]]] call Waldo_fnc_DynamicAACreate;";
		};
		id=1;
		type="Land_HelipadEmpty_F";
	};
	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,0,-5};};
		title="Dynamic AA guided example. The named settings create WEST-owned radar, static AA and mobile AA around this invisible centre. Aircraft must be inside the 2000 m horizontal detection area, between 100-1500 m altitude and inside the 1500 m engagement area before weapons may fire; ground targets are never valid. Place on open, reasonably flat land so every asset receives a separate safe footprint. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Dynamic-Anti-Air";
		id=2;
	};
};
