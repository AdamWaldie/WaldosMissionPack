	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-5,0};};
		title="Hazard Emitter (Moving): a 20 m contamination field that follows this vehicle wherever it is driven, instead of a fixed-area zone - the moving counterpart to the Radiation Hazard Example composition. Uses Waldo_fnc_HazardRegisterEmitter directly with a hand-authored profile (no preset key); drag this same call onto any other object to make it the hazard's source. The event handler that unregisters the zone if this vehicle is destroyed/deleted is installed automatically. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Optional-Feature-Systems#hazardous-environments";
		id=2;
	};
