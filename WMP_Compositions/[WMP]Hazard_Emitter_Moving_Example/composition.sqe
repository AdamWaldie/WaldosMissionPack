			name="WMP_HazardEmitterVehicle";
			init="[""composition_radiation_emitter_mobile"", this, 20, createHashMapFromArray [[""type"", ""RADIATION""], [""label"", ""Contaminated Transport""], [""rate"", 1], [""decay"", 0.15], [""damageThresholds"", [[15, 0.02], [35, 0.06]]], [""protectInVehicles"", true], [""vehicleFactor"", 0.1], [""audioEnabled"", true], [""geigerLowSounds"", [""Waldo_Hazard_GeigerLow1"", ""Waldo_Hazard_GeigerLow2"", ""Waldo_Hazard_GeigerLow3"", ""Waldo_Hazard_GeigerLow4""]], [""geigerHighSounds"", [""Waldo_Hazard_Geiger1"", ""Waldo_Hazard_Geiger2"", ""Waldo_Hazard_Geiger3"", ""Waldo_Hazard_Geiger4""]], [""geigerHighIntensity"", 0.5], [""geigerMinimumInterval"", 0.5], [""geigerMaximumInterval"", 2.5]]] call Waldo_fnc_HazardRegisterEmitter;";
