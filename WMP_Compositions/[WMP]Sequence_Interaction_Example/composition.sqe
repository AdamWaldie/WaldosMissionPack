version=54;
center[]={0,0,0};
class items
{
	items=2;
	class Item0
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={0,0,0};};
		class Attributes
		{
			name="WMP_Interaction_Sequence_Console";
			init="[this, ""sequence"", createHashMapFromArray [[""difficulty"", ""easy""], [""actionTitle"", ""Operate Control Desk""], [""title"", ""SEQUENCE CONTROL DESK""], [""onSuccess"", {[createHashMapFromArray [['title', 'SEQUENCE COMPLETE'], ['message', 'Control desk sequence completed. Reinforcements inbound.'], ['state', 'SUCCESS'], ['duration', 10], ['placement', 'TOP'], ['audience', 'SIDE'], ['side', west]]] call Waldo_fnc_NotificationBroadcast;}], [""onFailure"", {['Sequence rejected. Try again.'] remoteExec ['systemChat', 0];}]]] call Waldo_fnc_MiniGameInteractionSetup;";
		};
		id=1;
		type="Land_PortableDesk_01_sand_F";
	};
	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-4,0};};
		title="Sequence Interaction Example: a real gameplay outcome, not just the procedure by itself. Passing the desk sequence broadcasts a Waldo_fnc_NotificationBroadcast WMP UI card to the whole WEST side (not just the acting player) - the same audience-targeted call used by Zeus's Send Notification module. Copy the onSuccess pattern in the console's init field onto your own object to alert a side, group or unit list. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Waldos-Mini-Games";
		id=2;
	};
};
