	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,0,-5};};
		title="Dynamic Anti-Air (Minimal): id and centre are the smallest working call. It generates one EAST radar with no static/mobile response assets, a 2000 m horizontal detection area, 60 m floor and 10000 m ceiling. This demonstrates defaults, not a balanced live setup. Use the Full example to learn explicit engagement limits and response counts. Place it on open, reasonably flat ground. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Dynamic-Anti-Air";
		id=2;
	};
