	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-5,0};};
		title="Dynamic Anti-Air (Minimal): the smallest working call - id and centre are all that's required. Generates just one radar (staticCount/mobileCount default to 0) on the east side within a 2000 m detection radius. See the Dynamic AA Example (Full) composition to see and edit every option, including static/mobile response assets. Needs real open, reasonably flat ground nearby - see the Full composition's comment for placement guidance. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Dynamic-Anti-Air";
		id=2;
	};
