	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,0,-3};};
		title="Field Resupply hub: unlimited stock and all sides. The nearby WMP_FieldResupplyCarrier is a real BLUFOR-grouped rifleman, not a side-empty decorative unit, and starts with 2 of 3 portable crates through its Init call: [this, currentCrates, maximumCrates] call Waldo_fnc_FieldResupplyAssignCarrier;. Copy that call onto an infantry unit which already belongs to the intended side/group. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Optional-Feature-Extensions#field-resupply";
		id=2;
	};
