		side="West";
		flags=6;
		class Attributes
		{
			name="WMP_FieldResupplyCarrier";
			init="[this, 2, 3] call Waldo_fnc_FieldResupplyAssignCarrier;";
			description="Field Resupply Carrier - already assigned 2/3 portable crates on mission start; see this unit's init field.";
		};
		id=3;
		type="B_Soldier_F";
