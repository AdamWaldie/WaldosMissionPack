	class Item0
	{
		dataType="Object";
		side="Empty";
		class PositionInfo {position[]={0,0,0};};
		class Attributes
		{
			name="WMP_FieldResupplyHub";
			init="[this, sideUnknown, -1] call Waldo_fnc_FieldResupplyRegisterHub;";
