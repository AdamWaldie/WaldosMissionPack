	class Item1
	{
		dataType="Comment";
		class PositionInfo {position[]={0,-3,0};};
		title="Field Resupply hub: unlimited stock and all sides. The nearby ""WMP_FieldResupplyCarrier"" unit is already assigned as a carrier on mission start (2 crates, 3 maximum) via its own init field - [this, currentCrates, maximumCrates] call Waldo_fnc_FieldResupplyAssignCarrier; - copy that one-line call onto any infantry unit instead of only doing it live through Zeus. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Optional-Feature-Extensions#field-resupply";
		id=2;
	};
