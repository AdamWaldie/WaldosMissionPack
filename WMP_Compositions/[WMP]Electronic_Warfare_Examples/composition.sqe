version=54;
center[]={0,0,0};
class items
{
	items=3;
	class Item0
	{
		dataType="Object";
		side="West";
		class PositionInfo {position[]={-4,0,0};};
		class Attributes
		{
			name="WMP_EMPImmuneVehicle";
			init="[this] call Waldo_fnc_EMPImmune;";
		};
		id=1;
		type="B_MRAP_01_F";
	};
	class Item1
	{
		dataType="Object";
		side="West";
		class PositionInfo {position[]={4,0,0};};
		class Attributes
		{
			name="WMP_TrackedVehicle";
			init="[this, west, ""Tracked Vehicle""] call Waldo_fnc_Tracker;";
		};
		id=2;
		type="B_MRAP_01_F";
	};
	class Item2
	{
		dataType="Comment";
		class PositionInfo {position[]={0,0,-5};};
		title="Electronic-warfare quick starts. The left MRAP ignores WMP EMP effects. The right MRAP broadcasts a WEST-only tracker named Tracked Vehicle. Copy the relevant vehicle init onto your own vehicle; replace west to change who receives the tracker. These examples do not create an EMP or jammer by themselves. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Electronic-Warfare-EMP-And-Signal-Trackers";
		id=3;
	};
};
