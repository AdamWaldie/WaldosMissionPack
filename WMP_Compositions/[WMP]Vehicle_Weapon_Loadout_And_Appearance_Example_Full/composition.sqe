class items
{
	items=3;
	class Item0
	{
		dataType="Object";
		side="West";
		class PositionInfo {position[]={0,0,0}; angles[]={0,0,0};};
		class Attributes
		{
			name="WMP_VehWpnDonor";
		};
		id=1;
		type="B_MRAP_01_gmg_F";
	};
	class Item1
	{
		dataType="Object";
		side="West";
		class PositionInfo {position[]={8,0,0}; angles[]={0,0,0};};
		class Attributes
		{
			name="WMP_VehWpnTarget";
			init="[WMP_VehWpnDonor, this] call Waldo_fnc_VehicleWeaponLoadoutCopy; [this, [[""TEXTURE"", 0, ""SET"", [1,0,1,1]]]] call Waldo_fnc_VehicleAppearanceApply;";
		};
		id=2;
		type="B_MRAP_01_hmg_F";
	};
	class Item2
	{
		dataType="Comment";
		class PositionInfo {position[]={4,0,-8};};
		title="Vehicle Weapon Loadout And Appearance example: the donor is a GMG-armed Hunter, the target an HMG-armed Hunter - a real, visible loadout swap, not a same-to-same copy. Both share the Hunter family's turret[0] path, which is all Copy requires; the GMG/HMG classnames are never typed anywhere. Waldo_fnc_VehicleWeaponLoadoutCopy reads the donor's live turret state and replaces the target's HMG with it. The target is also painted solid pink via Waldo_fnc_VehicleAppearanceApply's procedural texture syntax (no asset needed) as a visible cue the call ran. Wiki: https://github.com/AdamWaldie/WaldosMissionPack/wiki/Vehicle-Weapon-Loadout";
		id=3;
	};
};
